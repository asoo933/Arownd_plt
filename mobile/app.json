{
  "expo": {
    "name": "Arownd",
    "slug": "arownd-mobile",
    "scheme": "com.arownd.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج Arownd إلى الوصول إلى الصور لاختيار صور المنتجات.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arownd.app"
    },
    "android": {
      "package": "com.arownd.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    }
  }
}