{
  "expo": {
    "name": "Arownd",
    "slug": "arownd",
    "scheme": "com.arownd.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "updates": {
      "url": "https://u.expo.dev/a6f00c82-1762-4156-8c7d-6289f496b18f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج Arownd إلى الوصول إلى الصور لاختيار صور المنتجات.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-optional-camera-feature",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arownd.app"
    },
    "android": {
      "package": "com.arownd.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "a6f00c82-1762-4156-8c7d-6289f496b18f"
      }
    }
  }
}
